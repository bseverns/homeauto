#!/usr/bin/env python3
"""Build a bounded local view of BenLab reports and human directives."""

from __future__ import annotations

import argparse
import csv
import hashlib
import html
import json
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = ROOT / "coordination" / "sources.json"
DIRECTIVES_DIR = ROOT / "coordination" / "directives"
WORLD_STATE_PATH = ROOT / "coordination" / "state" / "world-state.json"
ROUTINES_PATH = ROOT / "coordination" / "routines.json"
ROUTINE_RECEIPTS_DIR = ROOT / "coordination" / "state" / "routine-receipts"
TARGETS = ("benlab", "benlab-local-analyst", "schedule-assessment", "homeauto")
ACTION_TYPES = (
    "review_candidate",
    "promote_candidate",
    "refresh_report",
    "assess_capacity",
    "propose_schedule",
    "repo_action",
    "note",
)
ANALYST_COMMANDS = frozenset({
    "scan", "find", "path", "read", "ask", "export-benlab-intake", "import-syntheses",
    "migrate-cards", "migrate-candidate-markers", "benlab-tend", "benlab-challenge",
    "benlab-connect", "benlab-propose", "batch-rebuild",
})
ANALYST_WRITE_COMMANDS = {
    "scan", "read", "export-benlab-intake", "import-syntheses", "migrate-cards",
    "migrate-candidate-markers", "batch-rebuild",
}


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def valid_datetime(value: Any) -> bool:
    try:
        return isinstance(value, str) and datetime.fromisoformat(value.replace("Z", "+00:00")).tzinfo is not None
    except ValueError:
        return False


def resolve_path(value: str) -> Path:
    path = Path(value).expanduser()
    return path if path.is_absolute() else (ROOT / path).resolve()


def source_status(name: str, spec: dict[str, Any]) -> dict[str, Any]:
    path = resolve_path(spec["path"])
    result = {
        "name": name,
        "available": path.is_file(),
        "configured_path": spec["path"],
        "authority": spec.get("authority", ""),
    }
    if path.is_file():
        result["modified_at"] = datetime.fromtimestamp(
            path.stat().st_mtime, timezone.utc
        ).isoformat()
    return result


def summarize_benlab(path: Path) -> dict[str, Any]:
    payload = read_json(path)
    contract = payload.get("contract", {})
    if (
        contract.get("name") != "benlab-actions"
        or contract.get("schema_version") not in {"1.0.0", "1.1.0"}
        or contract.get("authority") != "human-authored project attention metadata"
        or contract.get("prose_inference_allowed") is not False
        or not valid_datetime(payload.get("generated_at"))
    ):
        raise ValueError(f"unsupported BenLab action contract: {contract!r}")

    queue_locations = {
        project: (queue_name, position)
        for queue_name in ("now", "next", "background")
        for position, project in enumerate(payload.get("queues", {}).get(queue_name, []), 1)
    }

    def normalize_action(action: dict[str, Any]) -> dict[str, Any]:
        queue_name, queue_position = queue_locations.get(
            action.get("project"), (action.get("attention_state"), None)
        )
        provenance = {
            field: action.get(f"{field}_source")
            for field in (
                "next_action", "next_action_effort", "next_action_stack", "next_action_route",
                "evidence_status", "evidence_blocker", "evidence_note", "fastest_capture",
                "missing_proof", "portfolio_blocker", "portfolio_ready", "proof_mode",
                "public_claim", "public_safe", "risk",
            )
            if f"{field}_source" in action
        }
        return {
            "action_id": action.get("action_id"),
            "project_id": action.get("path"),
            "project": action.get("project"),
            "attention_state": action.get("attention_state"),
            "queue": queue_name,
            "queue_position": queue_position,
            "current_commitment": action.get("current_commitment"),
            "may_request_time_now": action.get("may_request_time_now"),
            "next_action": action.get("next_action"),
            "effort": action.get("next_action_effort"),
            "energy_fit": action.get("energy_fit"),
            "required_stack": action.get("next_action_stack") or [],
            "route": action.get("next_action_route"),
            "evidence": {
                "status": action.get("evidence_status"),
                "blocker": action.get("evidence_blocker"),
                "note": action.get("evidence_note"),
                "provenance": provenance,
            },
            "blocker_state": {
                "evidence": action.get("evidence_blocker"),
                "portfolio": action.get("portfolio_blocker"),
                "risk": action.get("risk"),
            },
            "proof_mode": action.get("proof_mode"),
            "readiness": action.get("ready_for") or [],
            "public_safety": {"safe": action.get("public_safe"), "claim": action.get("public_claim")},
            "human_activation_reason": action.get("attention_reason") or action.get("why_active"),
            "sleeping": action.get("attention_state") == "sleeping",
            "status": action.get("status"),
        }

    actions = [normalize_action(action) for action in payload.get("actions", []) if isinstance(action, dict)]
    queue_rank = {"now": 0, "next": 1, "background": 2, "sleeping": 3}
    actions.sort(key=lambda item: (
        queue_rank.get(item.get("queue"), 4),
        item.get("queue_position") if item.get("queue_position") is not None else 1_000_000,
    ))

    actions_by_project = {
        action.get("project"): action
        for action in actions
        if action.get("project")
    }

    def queue(name: str) -> list[dict[str, Any]]:
        rows = []
        for project in payload.get("queues", {}).get(name, []):
            action = actions_by_project.get(project, {})
            rows.append(
                {
                    "project": project,
                    "action_id": action.get("action_id"),
                    "project_id": action.get("project_id"),
                    "queue_position": action.get("queue_position"),
                    "attention": action.get("attention_state", name),
                    "next_action": action.get("next_action"),
                    "effort": action.get("effort"),
                    "energy_fit": action.get("energy_fit"),
                    "stack": action.get("required_stack") or [],
                    "route": action.get("route"),
                }
            )
        return rows

    return {
        "generated_at": payload.get("generated_at"),
        "contract": contract,
        "artifact_sha256": sha256_file(path),
        "attention_budget": payload.get("attention_budget", {}),
        "actions": actions,
        "now": queue("now"),
        "next": queue("next"),
        "sleeping_count": len(payload.get("sleeping", [])),
    }


def summarize_analyst(path: Path, limit: int = 8) -> dict[str, Any]:
    payload = read_json(path)
    promotions = payload.get("promotions", [])
    statuses = Counter(
        item.get("promotion_recommendation", {}).get("status", "unspecified")
        for item in promotions
    )
    recent = sorted(
        promotions,
        key=lambda item: item.get("created_unix") or 0,
        reverse=True,
    )[:limit]
    # Deliberately exclude source_path, evidence bodies, and full card content.
    candidates = []
    for item in recent:
        recommendation = item.get("promotion_recommendation", {})
        intake = item.get("benlab_intake", {})
        candidates.append(
            {
                "card_id": item.get("card_id"),
                "working_title": item.get("working_title"),
                "recommendation": recommendation.get("status"),
                "promotion_target": recommendation.get("promotion_target"),
                "suggested_route": intake.get("suggested_route"),
                "suggested_next_step": intake.get("suggested_next_step"),
                "estimated_effort": intake.get("estimated_effort"),
                "public_safety_status": intake.get("public_safety_status"),
            }
        )
    return {
        "generated_at": payload.get("generated_at"),
        "contract_version": payload.get("contract_version"),
        "candidate_count": len(promotions),
        "recommendation_counts": dict(sorted(statuses.items())),
        "recent_candidates": candidates,
    }


def summarize_capacity(path: Path) -> dict[str, Any]:
    if path.suffix == ".json":
        payload = read_json(path)
        contract = payload.get("contract", {})
        if (
            contract.get("name") != "schedule-capacity"
            or contract.get("schema_version") != "1.0.0"
            or contract.get("authority") != "read_only_capacity_evidence"
            or contract.get("scheduling_authority") is not False
            or contract.get("calendar_mutation_allowed") is not False
            or contract.get("prose_inference_allowed") is not False
            or not valid_datetime(contract.get("generated_at"))
        ):
            raise ValueError(f"unsupported schedule capacity contract: {contract!r}")
        inputs = payload.get("inputs", {})
        source_hash = inputs.get("benlab_artifact_sha256")
        if (
            inputs.get("benlab_contract_name") != "benlab-actions"
            or inputs.get("benlab_schema_version") not in {"1.0.0", "1.1.0"}
            or (source_hash is not None and not re.fullmatch(r"[0-9a-f]{64}", str(source_hash)))
        ):
            raise ValueError(f"invalid schedule capacity input: {inputs!r}")
        freshness = payload.get("freshness", {})
        if freshness.get("status") != "fresh" and any(item.get("fit_status") == "fits" for item in payload.get("results", [])):
            raise ValueError("schedule capacity contract contains fits without fresh capacity evidence")
        fits = []
        for item in payload.get("results", []):
            if item.get("fit_status") != "fits":
                continue
            fits.append({
                "action_id": item.get("action_id"),
                "project_id": item.get("project_id"),
                "project": item.get("project"),
                "queue": item.get("queue"),
                "queue_position": item.get("queue_position"),
                "next_action": item.get("action"),
                "effort": item.get("effort"),
                "energy_fit": item.get("energy_fit"),
                "block_start": item.get("capacity_start"),
                "block_end": item.get("capacity_end"),
                "temporal_status": item.get("source_freshness"),
            })
        return {
            "contract": contract,
            "artifact_sha256": sha256_file(path),
            "inputs": inputs,
            "freshness": freshness,
            "result_count": len(payload.get("results", [])),
            "fit_count": len(fits),
            "fits": fits,
            "results": [dict(item) for item in payload.get("results", []) if isinstance(item, dict)],
        }

    with path.open(encoding="utf-8", newline="") as handle:
        rows = list(csv.DictReader(handle))
    fields = (
        "project",
        "attention",
        "next_action",
        "effort",
        "energy_fit",
        "stack",
        "route",
        "block_date",
        "block_start",
        "block_end",
        "buffer_minutes",
    )
    today = datetime.now().astimezone().date()
    fits = []
    for row in rows:
        fit = {field: row.get(field) for field in fields}
        try:
            block_date = datetime.strptime(row.get("block_date", ""), "%Y-%m-%d").date()
            fit["temporal_status"] = (
                "elapsed" if block_date < today else "today" if block_date == today else "upcoming"
            )
        except ValueError:
            fit["temporal_status"] = "unknown"
        fits.append(fit)
    return {
        "fit_count": len(rows),
        "fits": fits,
    }


def summarize_freshness(path: Path) -> dict[str, Any]:
    payload = read_json(path)
    artifacts = payload.get("artifacts", [])
    statuses = Counter(item.get("status", "unknown") for item in artifacts)
    warnings = [
        {
            "path": item.get("path"),
            "status": item.get("status"),
            "warning": item.get("warning"),
        }
        for item in artifacts
        if item.get("warning")
    ]
    return {
        "generated_at": payload.get("generated_at"),
        "status_counts": dict(sorted(statuses.items())),
        "warnings": warnings,
    }


def validate_directive(payload: dict[str, Any], source: Path) -> list[str]:
    errors = []
    required = {
        "contract_version",
        "id",
        "created_at",
        "authority",
        "status",
        "target",
        "action_type",
        "instruction",
        "requires_confirmation",
        "source_refs",
        "constraints",
    }
    missing = sorted(required - payload.keys())
    if missing:
        errors.append(f"missing fields: {', '.join(missing)}")
    if payload.get("contract_version") != 1:
        errors.append("contract_version must be 1")
    if payload.get("authority") != "human":
        errors.append("authority must be human")
    if payload.get("target") not in TARGETS:
        errors.append("unknown target")
    if payload.get("action_type") not in ACTION_TYPES:
        errors.append("unknown action_type")
    if payload.get("status") not in {
        "draft", "approved", "dispatched", "completed", "cancelled"
    }:
        errors.append("unknown status")
    if payload.get("requires_confirmation") is not True:
        errors.append("requires_confirmation must be true")
    if not str(payload.get("instruction", "")).strip():
        errors.append("instruction must not be empty")
    return [f"{source.name}: {error}" for error in errors]


def load_directives(directory: Path = DIRECTIVES_DIR) -> tuple[list[dict[str, Any]], list[str]]:
    directives = []
    errors = []
    if not directory.exists():
        return directives, errors
    for path in sorted(directory.glob("*.json")):
        try:
            payload = read_json(path)
            file_errors = validate_directive(payload, path)
            if file_errors:
                errors.extend(file_errors)
            else:
                directives.append(payload)
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f"{path.name}: {exc}")
    return directives, errors


def load_routines(path: Path = ROUTINES_PATH) -> dict[str, dict[str, Any]]:
    payload = read_json(path)
    routines = {}
    required = {
        "id", "label", "description", "target", "adapter", "cwd", "command",
        "read_only", "requires_confirmation", "expected_output", "duration", "interaction",
    }
    for routine in payload.get("routines", []):
        missing = required - routine.keys()
        if missing:
            raise ValueError(f"routine missing fields: {', '.join(sorted(missing))}")
        routine_id = routine["id"]
        if routine_id in routines:
            raise ValueError(f"duplicate routine id: {routine_id}")
        if not isinstance(routine["command"], list) or not routine["command"]:
            raise ValueError(f"routine {routine_id} command must be a non-empty argv list")
        routines[routine_id] = routine
    return routines


def load_routine_receipts(directory: Path = ROUTINE_RECEIPTS_DIR) -> tuple[list[dict[str, Any]], list[str]]:
    receipts, errors = [], []
    if not directory.exists():
        return receipts, errors
    for path in sorted(directory.glob("*.json"), reverse=True)[:100]:
        try:
            receipts.append(read_json(path))
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f"{path.name}: {exc}")
    return receipts, errors


def analyst_requires_confirmation(arguments: list[str]) -> bool:
    if not arguments or arguments[0] not in ANALYST_COMMANDS:
        command = arguments[0] if arguments else ""
        raise ValueError(f"unknown Analyst command: {command or '(missing)'}")
    command = arguments[0]
    if "--help" in arguments[1:]:
        return False
    if command == "migrate-cards" and "--dry-run" in arguments[1:]:
        return False
    if command == "migrate-candidate-markers":
        if any("--apply".startswith(argument) and argument != "--apply" for argument in arguments[1:]):
            raise ValueError("spell --apply in full")
        return "--apply" in arguments[1:]
    return command in ANALYST_WRITE_COMMANDS


def analyst_model(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]*", value):
        raise argparse.ArgumentTypeError("model must contain only letters, digits, . _ : / or -")
    return value


def run_routine(
    routine_id: str,
    registry_path: Path = ROUTINES_PATH,
    receipt_dir: Path = ROUTINE_RECEIPTS_DIR,
    *,
    input_value: str | None = None,
    arguments: list[str] | None = None,
    environment: dict[str, str] | None = None,
    action_id: str | None = None,
    opportunity_id: str | None = None,
    confirmed: bool = False,
    refresh_world_state: bool = True,
) -> dict[str, Any]:
    routines = load_routines(registry_path)
    if routine_id not in routines:
        raise ValueError(f"unknown routine: {routine_id}")
    routine = routines[routine_id]
    if routine["requires_confirmation"] and not confirmed:
        raise PermissionError(f"{routine_id} requires confirmation; repeat with --yes")

    command = []
    for argument in routine["command"]:
        argument = os.path.expandvars(argument)
        if argument == "{args}":
            if arguments is None:
                raise ValueError(f"{routine_id} requires command arguments")
            command.extend(arguments)
            continue
        if "{args}" in argument:
            raise ValueError(f"{routine_id} must use {{args}} as a complete argv element")
        if "{input}" in argument:
            if not input_value:
                raise ValueError(f"{routine_id} requires --input")
            argument = argument.replace("{input}", input_value)
        command.append(argument)

    now = datetime.now(timezone.utc)
    receipt_id = f"{now.strftime('%Y%m%dT%H%M%S.%fZ')}-{routine_id}"
    receipt_dir.mkdir(parents=True, exist_ok=True)
    receipt_path = receipt_dir / f"{receipt_id}.json"
    artifact_path = receipt_dir.parent / "routine-artifacts" / f"{receipt_id}.txt"
    receipt = {
        "contract_version": 1,
        "id": receipt_id,
        "routine": routine_id,
        "label": routine["label"],
        "requested_at": now.isoformat(),
        "requested_by": "human",
        "target": routine["target"],
        "action_id": action_id,
        "opportunity_id": opportunity_id,
        "supplied_inputs": {"input": input_value, "arguments": arguments or []},
        "source_authority": routine["target"],
        "started": False,
        "result": "running",
        "artifact": None,
        "exit_code": None,
        "refreshed_world_state": False,
        "refresh_exit_code": None,
        "canonical_source_changed": False if routine["read_only"] else None,
        "semantic_completion": False,
        "return_destination": routine["target"],
    }
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")

    adapter = Path(routine["adapter"])
    if not adapter.is_absolute():
        adapter = ROOT / adapter
    cwd = Path(os.path.expandvars(routine["cwd"]))
    if not cwd.is_absolute():
        cwd = ROOT / cwd
    try:
        run_options: dict[str, Any] = {"cwd": cwd, "check": False}
        if environment:
            run_options["env"] = {**os.environ, **environment}
        if routine["interaction"] == "guided":
            completed = subprocess.run([str(adapter), *command], **run_options)
        else:
            completed = subprocess.run(
                [str(adapter), *command], **run_options,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            )
        receipt["started"] = True
        receipt["exit_code"] = completed.returncode
        receipt["result"] = "completed" if completed.returncode == 0 else "failed"
        if routine["interaction"] != "guided":
            artifact_path.parent.mkdir(parents=True, exist_ok=True)
            artifact_path.write_text(completed.stdout or "", encoding="utf-8")
            print(completed.stdout or "", end="")
            receipt["artifact"] = str(artifact_path)
    except OSError as exc:
        receipt["result"] = "failed"
        receipt["error"] = str(exc)
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")

    if refresh_world_state and receipt["result"] == "completed":
        refresh_command = (
            [str(ROOT / "scripts" / "lab-console"), "refresh"]
            if routine_id == "refresh"
            else ["arch", "-arm64", "/usr/bin/make", "coordination-refresh"]
        )
        try:
            refreshed = subprocess.run(refresh_command, cwd=ROOT, check=False)
            receipt["refresh_exit_code"] = refreshed.returncode
            receipt["refreshed_world_state"] = refreshed.returncode == 0
            if refreshed.returncode != 0:
                receipt["result"] = "refresh-failed"
        except OSError as exc:
            receipt["result"] = "refresh-failed"
            receipt["refresh_error"] = str(exc)
        receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    if refresh_world_state:
        write_snapshot(DEFAULT_CONFIG)
    return receipt


def run_analyst(arguments: list[str], model: str | None, confirmed: bool) -> dict[str, Any]:
    writes = analyst_requires_confirmation(arguments)
    if writes and not confirmed:
        raise PermissionError(f"Analyst {arguments[0]} writes data; repeat with --yes")
    return run_routine(
        "analyst-write" if writes else "analyst-readonly",
        arguments=arguments,
        environment={"OLLAMA_CHAT_MODEL": model} if model else None,
        confirmed=confirmed,
    )


def build_snapshot(config_path: Path = DEFAULT_CONFIG) -> dict[str, Any]:
    config = read_json(config_path)
    specs = config.get("sources", {})
    statuses = {name: source_status(name, spec) for name, spec in specs.items()}
    warnings = []

    def load_summary(name: str, loader: Any) -> dict[str, Any] | None:
        status = statuses.get(name, {})
        if not status.get("available"):
            warnings.append(f"Missing source: {name} ({status.get('configured_path')})")
            return None
        try:
            return loader(resolve_path(specs[name]["path"]))
        except (OSError, ValueError, KeyError, csv.Error, json.JSONDecodeError) as exc:
            warnings.append(f"Could not read {name}: {exc}")
            return None

    directives, directive_errors = load_directives()
    routine_receipts, receipt_errors = load_routine_receipts()
    warnings.extend(directive_errors)
    warnings.extend(receipt_errors)
    benlab = load_summary("benlab_actions", summarize_benlab)
    capacity = load_summary("schedule_capacity", summarize_capacity)
    if benlab and capacity:
        capacity_input = capacity.get("inputs", {})
        mismatch = (
            capacity_input.get("benlab_contract_name") != benlab.get("contract", {}).get("name")
            or capacity_input.get("benlab_schema_version") != benlab.get("contract", {}).get("schema_version")
            or capacity_input.get("benlab_artifact_sha256") != benlab.get("artifact_sha256")
            or (
                capacity_input.get("benlab_generated_at") is not None
                and capacity_input.get("benlab_generated_at") != benlab.get("generated_at")
            )
        )
        if mismatch:
            warnings.append("schedule-capacity source binding does not match loaded BenLab artifact")
            capacity = None
    snapshot = {
        "contract": {
            "name": "benlab-operator-snapshot",
            "schema_version": "1.0.0",
            "authority": "read-only aggregation plus human-authored directives",
        },
        "generated_at": utc_now(),
        "sources": statuses,
        "benlab": benlab,
        "analyst": load_summary("analyst_promotions", summarize_analyst),
        "schedule": {
            "capacity": capacity,
            "freshness": capacity.get("freshness", {}) if capacity else {},
        },
        "directives": directives,
        "routine_receipts": routine_receipts,
        "world_state": read_json(WORLD_STATE_PATH) if WORLD_STATE_PATH.is_file() else None,
        "warnings": warnings,
        "boundaries": [
            "Analyst candidates are not commitments.",
            "Only BenLab owns attention and project commitment.",
            "Capacity fit is not a scheduled calendar event.",
            "Directives require human confirmation and are not auto-dispatched.",
        ],
    }
    return snapshot


def cell(value: Any) -> str:
    if value is None or value == "":
        return "—"
    if isinstance(value, list):
        value = ", ".join(str(item) for item in value)
    escaped = html.escape(str(value)).replace("\r\n", " ").replace("\r", " ").replace("\n", " ")
    return re.sub(r"([\\`*_\[\]()!|])", r"\\\1", escaped)


def render_dashboard(snapshot: dict[str, Any]) -> str:
    world_state = snapshot.get("world_state") or {}
    opportunities = world_state.get("opportunities", [])

    def opportunity_lines(rows: list[dict[str, Any]], empty: str) -> list[str]:
        rendered = []
        for item in rows:
            action = item.get("action", {})
            capacity = item.get("capacity") or {}
            rendered.extend([
                f"### {cell(action.get('project'))}",
                "",
                f"**{cell(item.get('state', '').upper())}** · {cell(action.get('effort'))} · {cell(action.get('energy_fit'))}",
                "",
                f"Action: {cell(action.get('next_action'))}",
                f"Capacity: {cell(capacity.get('capacity_start'))} – {cell(capacity.get('capacity_end'))}",
                f"Affordances: required {cell(item.get('affordances', {}).get('required', []))}; missing {cell(item.get('affordances', {}).get('missing', []))}",
                "",
                "Why?",
            ])
            rendered.extend(f"- {cell(reason.get('detail'))}" for reason in item.get("why", []))
            rendered.extend(["", "_No action has been scheduled or dispatched._", ""])
        return rendered or [empty, ""]

    available = [item for item in opportunities if item.get("state") == "available"]
    blocked = [item for item in opportunities if item.get("state") in {"blocked", "missing_affordance"}]
    uncertain = [item for item in opportunities if item.get("state") in {"capacity_stale", "runtime_stale", "insufficient_information", "not_currently_eligible"}]
    recent = [item for item in world_state.get("transitions", []) if str(item.get("situation_id", "")).startswith("opportunity:")][-10:]
    lines = [
        "# BenLab operator dashboard",
        "",
        f"Generated: `{snapshot['generated_at']}`",
        "",
        "> Read-only orientation surface. Analyst candidates are not commitments; capacity",
        "> fits are not calendar events; directives are inert until explicitly reviewed.",
        "",
        "## Available now",
        "",
        *opportunity_lines(available, "No opportunities are currently available."),
        "## Recently changed",
        "",
        *(f"- `{cell(item.get('situation_id'))}`: {cell(item.get('from'))} → {cell(item.get('to'))} — {cell(item.get('cause'))}" for item in recent),
        *( [] if recent else ["No meaningful opportunity-state changes recorded."] ),
        "",
        "## Blocked / missing affordances",
        "",
        *opportunity_lines(blocked, "No current opportunities are explicitly blocked or missing affordances."),
        "## Stale or uncertain evidence",
        "",
        *opportunity_lines(uncertain, "No current opportunities have stale or uncertain evidence."),
        "## Intentional routines",
        "",
        "| Today | This week | This month | Now |",
        "| --- | --- | --- | --- |",
        "| Encounter<br>`lab-console run daily` | Connect<br>`lab-console run weekly` | Reorient<br>`lab-console run monthly` | Refresh<br>`lab-console run refresh` |",
        "",
        "Ask: `lab-console ask \"What changed since yesterday?\"`",
        "Analyst CLI: `lab-console analyst --help` (queries and paths stay in each invocation)",
        "",
        "## Tentacles",
        "",
    ]
    for source_name, label, target, routine_id in (
        ("benlab_actions", "BenLab", "benlab", "benlab-refresh"),
        ("analyst_promotions", "Analyst", "analyst", "analyst-scan"),
        ("schedule_capacity", "Capacity", "capacity", "capacity"),
    ):
        source = snapshot.get("sources", {}).get(source_name, {})
        if source.get("available") and source.get("configured_path"):
            lines.append(
                f"- [{label} details]({resolve_path(source['configured_path']).as_uri()}) · "
                f"`lab-console open {target}` · `lab-console run {routine_id}`"
            )
    lines.extend([
        "",
        "## Recent activity",
        "",
        "| Routine | Result | Requested | Target |",
        "| --- | --- | --- | --- |",
    ])
    receipts = snapshot.get("routine_receipts", [])[:10]
    lines.extend(
        f"| {cell(item.get('label') or item.get('routine'))} | {cell(item.get('result'))} | "
        f"{cell(item.get('requested_at'))} | {cell(item.get('target'))} |"
        for item in receipts
    )
    if not receipts:
        lines.append("| — | not run | — | — |")
    lines.extend(
        [
            "",
            "## Source health",
            "",
            "| Source | Available | Source generated | File modified (UTC) |",
            "| --- | --- | --- | --- |",
        ]
    )
    generated = {
        "benlab_actions": (snapshot.get("benlab") or {}).get("generated_at"),
        "analyst_promotions": (snapshot.get("analyst") or {}).get("generated_at"),
        "schedule_freshness": (
            snapshot.get("schedule", {}).get("freshness") or {}
        ).get("generated_at"),
    }
    for name, status in snapshot["sources"].items():
        lines.append(
            f"| {cell(name)} | {cell(status['available'])} | "
            f"{cell(generated.get(name))} | {cell(status.get('modified_at'))} |"
        )

    benlab = snapshot.get("benlab")
    lines.extend(["", "## BenLab attention", ""])
    if not benlab:
        lines.append("BenLab actions are unavailable.")
    else:
        budget = benlab.get("attention_budget", {})
        lines.append(
            f"Attention budget within bounds: **{cell(budget.get('within_budget'))}**. "
            f"Sleeping projects: **{benlab.get('sleeping_count', 0)}**."
        )
        for queue_name in ("now", "next"):
            lines.extend(
                [
                    "",
                    f"### {queue_name.title()}",
                    "",
                    "| Project | Action | Effort | Stack | Route |",
                    "| --- | --- | --- | --- | --- |",
                ]
            )
            for item in benlab.get(queue_name, []):
                lines.append(
                    f"| {cell(item['project'])} | {cell(item['next_action'])} | "
                    f"{cell(item['effort'])} | {cell(item['stack'])} | {cell(item['route'])} |"
                )

    capacity = snapshot.get("schedule", {}).get("capacity")
    lines.extend(["", "## Capacity fit", ""])
    if not capacity:
        lines.append("Capacity assessment is unavailable.")
    else:
        lines.extend(
            [
                "| Project | Fit window | Timing | Effort | Energy | Action |",
                "| --- | --- | --- | --- | --- | --- |",
            ]
        )
        for item in capacity.get("fits", []):
            block = f"{item.get('block_start', '')} – {item.get('block_end', '')}"
            lines.append(
                f"| {cell(item.get('project'))} | {cell(block)} | {cell(item.get('temporal_status'))} | {cell(item.get('effort'))} | "
                f"{cell(item.get('energy_fit'))} | {cell(item.get('next_action'))} |"
            )
        if not capacity.get("fits"):
            lines.append("| — | — | — | — | — | No current fit rows |")

    analyst = snapshot.get("analyst")
    lines.extend(["", "## Research", "", "### Recent Analyst candidates", ""])
    if not analyst:
        lines.append("Analyst promotions are unavailable.")
    else:
        lines.append(
            f"Total candidates: **{analyst['candidate_count']}**. Recommendation counts: "
            f"`{json.dumps(analyst['recommendation_counts'], sort_keys=True)}`."
        )
        lines.extend(
            [
                "",
                "| Card | Working title | Recommendation | Route | Suggested next step |",
                "| --- | --- | --- | --- | --- |",
            ]
        )
        for item in analyst.get("recent_candidates", []):
            lines.append(
                f"| {cell(item.get('card_id'))} | {cell(item.get('working_title'))} | "
                f"{cell(item.get('recommendation'))} | {cell(item.get('suggested_route'))} | "
                f"{cell(item.get('suggested_next_step'))} |"
            )

    lines.extend(["", "## Open directives", ""])
    open_directives = [
        item
        for item in snapshot.get("directives", [])
        if item.get("status") not in {"completed", "cancelled"}
    ]
    if not open_directives:
        lines.append("No open directives.")
    else:
        lines.extend(
            [
                "| ID | Status | Target | Type | Instruction |",
                "| --- | --- | --- | --- | --- |",
            ]
        )
        for item in open_directives:
            lines.append(
                f"| {cell(item.get('id'))} | {cell(item.get('status'))} | "
                f"{cell(item.get('target'))} | {cell(item.get('action_type'))} | "
                f"{cell(item.get('instruction'))} |"
            )

    world_state = snapshot.get("world_state") or {}
    lines.extend(
        [
            "",
            "## Studio capabilities",
            "",
            "| Capability | Scope | State | Available resources |",
            "| --- | --- | --- | --- |",
        ]
    )
    capabilities = world_state.get("capabilities", [])
    for item in capabilities:
        lines.append(
            f"| {cell(item.get('capability'))} | {cell(item.get('scope'))} | {cell(item.get('state')).upper()} | "
            f"{int(item.get('available_resources', 0))} |"
        )
    if not capabilities:
        lines.append("| — | — | UNKNOWN | 0 |")

    lines.extend(
        [
            "",
            "## Studio Machines",
            "",
            "| Machine | Readiness | Runtime | Lifecycle | Freshness |",
            "| --- | --- | --- | --- | --- |",
        ]
    )
    transitions = world_state.get("transitions", [])
    machines = [item for item in world_state.get("machines", []) if item.get("dashboard", True)]
    for item in machines:
        lines.append(
            f"| {cell(item.get('label'))} | {cell(item.get('readiness')).upper()} | "
            f"{cell(item.get('runtime'))} | {cell(item.get('lifecycle'))} | {cell(item.get('freshness'))} |"
        )
        recent = [transition for transition in transitions if transition.get("situation_id") == item.get("id")][-3:]
        lines.extend(["", f"#### Why? {cell(item.get('label'))}", ""])
        lines.append(f"- Documentation: {cell(item.get('docs_ref') or 'canonical mapping unresolved')}")
        lines.append(f"- Lifecycle: {cell(item.get('lifecycle'))}")
        lines.append(f"- Capabilities: {cell(', '.join(item.get('capabilities', [])) or 'none declared')}")
        lines.append(f"- Current affordances: {cell(', '.join(item.get('affordances', [])) or 'none')}")
        lines.extend(f"- Evidence: {cell(reason)}" for reason in item.get("why", []))
        lines.extend(
            f"- Transition: {cell(transition.get('from'))} → {cell(transition.get('to'))} at {cell(transition.get('changed_at'))}"
            for transition in recent
        )
        lines.append("")
    if not machines:
        lines.append("| — | UNKNOWN | no registry entries | — | unavailable |")

    lines.extend(
        [
            "",
            "## World situations",
            "",
            "| Situation | State | Confidence |",
            "| --- | --- | --- |",
        ]
    )
    situations = world_state.get("situations", [])
    for item in situations:
        lines.append(
            f"| {cell(item.get('label'))} | {cell(item.get('state'))} | "
            f"{float(item.get('confidence', 0)):.2f} |"
        )
        lines.extend(
            [
                "",
                f"#### Why? {cell(item.get('label'))}",
                "",
                f"Rule: {cell(item.get('rule'))}",
                "",
            ]
        )
        reasons = item.get("why", [])
        lines.extend(f"- {cell(reason)}" for reason in reasons)
        if not reasons:
            lines.append("- No matching observations.")
        lines.append("")
    if not situations:
        lines.append("| — | unavailable | 0.00 |")

    lines.extend(["", "### World-state boundaries", ""])
    world_boundaries = world_state.get("boundaries", [])
    lines.extend(f"- {cell(boundary)}" for boundary in world_boundaries)
    if not world_boundaries:
        lines.append("- World state has not been collected yet; no control is inferred.")

    freshness = snapshot.get("schedule", {}).get("freshness") or {}
    all_warnings = list(snapshot.get("warnings", []))
    all_warnings.extend(
        f"{item.get('path')}: {item.get('warning')}" if isinstance(item, dict) else str(item)
        for item in freshness.get("warnings", [])
    )
    lines.extend(["", "## Warnings", ""])
    if all_warnings:
        lines.extend(f"- {warning}" for warning in all_warnings)
    else:
        lines.append("No source or freshness warnings.")

    lines.extend(["", "## Boundaries", ""])
    lines.extend(f"- {boundary}" for boundary in snapshot.get("boundaries", []))
    return "\n".join(lines) + "\n"


def output_paths(config_path: Path) -> tuple[Path, Path]:
    config = read_json(config_path)
    outputs = config.get("outputs", {})
    return resolve_path(outputs["snapshot"]), resolve_path(outputs["dashboard"])


def open_target(target: str, config_path: Path) -> None:
    config = read_json(config_path)
    if target == "dashboard":
        path = output_paths(config_path)[1]
    else:
        source = {
            "benlab": "benlab_actions",
            "analyst": "analyst_promotions",
            "capacity": "schedule_capacity",
        }[target]
        path = resolve_path(config.get("sources", {})[source]["path"])
    if not path.is_file():
        raise FileNotFoundError(path)
    subprocess.run(["open", str(path)], check=True)


def write_snapshot(config_path: Path) -> tuple[Path, Path, dict[str, Any]]:
    snapshot = build_snapshot(config_path)
    snapshot_path, dashboard_path = output_paths(config_path)
    snapshot_path.parent.mkdir(parents=True, exist_ok=True)
    dashboard_path.parent.mkdir(parents=True, exist_ok=True)
    snapshot_path.write_text(json.dumps(snapshot, indent=2) + "\n", encoding="utf-8")
    dashboard_path.write_text(render_dashboard(snapshot), encoding="utf-8")
    return snapshot_path, dashboard_path, snapshot


def slugify(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")[:48] or "action"


def create_directive(
    directory: Path,
    target: str,
    instruction: str,
    action_type: str,
    rationale: str = "",
    source_refs: list[str] | None = None,
    constraints: list[str] | None = None,
) -> Path:
    now = datetime.now(timezone.utc)
    directive_id = f"directive-{now.strftime('%Y%m%d-%H%M%S')}-{slugify(instruction)}"
    path = directory / f"{directive_id}.json"
    counter = 2
    while path.exists():
        path = directory / f"{directive_id}-{counter}.json"
        counter += 1
    payload = {
        "contract_version": 1,
        "id": path.stem,
        "created_at": now.isoformat(),
        "authority": "human",
        "status": "draft",
        "target": target,
        "action_type": action_type,
        "instruction": instruction.strip(),
        "rationale": rationale.strip(),
        "requires_confirmation": True,
        "source_refs": source_refs or [],
        "constraints": constraints or [],
        "outcome": None,
    }
    errors = validate_directive(payload, path)
    if errors:
        raise ValueError("; ".join(errors))
    directory.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    return path


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("refresh", help="write the local snapshot and dashboard")
    subparsers.add_parser("status", help="print a fresh dashboard without writing it")
    open_parser = subparsers.add_parser("open", help="open the dashboard or a detailed source view")
    open_parser.add_argument("target", choices=("dashboard", "benlab", "analyst", "capacity"), default="dashboard", nargs="?")
    subparsers.add_parser("routines", help="list registered operator routines")
    run = subparsers.add_parser("run", help="invoke a registered routine")
    run.add_argument("routine")
    run.add_argument("--input", help="explicit input required by parameterized routines")
    run.add_argument("--action-id", help="optional BenLab action ID to bind into the receipt")
    run.add_argument("--opportunity-id", help="optional derived opportunity ID to bind into the receipt")
    run.add_argument("--yes", action="store_true", help="confirm a routine that requires confirmation")
    analyst = subparsers.add_parser(
        "analyst",
        help="invoke an allowlisted benlab-local-analyst command",
        description="commands: " + ", ".join(sorted(ANALYST_COMMANDS)),
    )
    analyst.add_argument("--model", type=analyst_model, help="temporary OLLAMA_CHAT_MODEL override")
    analyst.add_argument("--yes", action="store_true", help="confirm a command that writes Analyst-owned data")
    analyst.add_argument("arguments", nargs=argparse.REMAINDER, help="Analyst command and its arguments")
    ask = subparsers.add_parser("ask", help="ask the local assistant about structured state")
    ask.add_argument("question")
    create = subparsers.add_parser("new-directive", help="create an inert draft directive")
    create.add_argument("target", choices=TARGETS)
    create.add_argument("instruction")
    create.add_argument("--type", choices=ACTION_TYPES, default="note", dest="action_type")
    create.add_argument("--rationale", default="")
    create.add_argument("--source", action="append", default=[], dest="source_refs")
    create.add_argument("--constraint", action="append", default=[], dest="constraints")
    args = parser.parse_args(argv)
    if args.command == "analyst" and "--yes" in args.arguments:
        args.yes = True
        args.arguments = [argument for argument in args.arguments if argument != "--yes"]
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    config_path = args.config.expanduser().resolve()
    if args.command == "refresh":
        snapshot_path, dashboard_path, snapshot = write_snapshot(config_path)
        freshness_warnings = (
            snapshot.get("schedule", {}).get("freshness") or {}
        ).get("warnings", [])
        print(f"snapshot: {snapshot_path}")
        print(f"dashboard: {dashboard_path}")
        print(f"warnings: {len(snapshot['warnings']) + len(freshness_warnings)}")
        return 0
    if args.command == "status":
        print(render_dashboard(build_snapshot(config_path)), end="")
        return 0
    if args.command == "open":
        try:
            open_target(args.target, config_path)
        except (KeyError, OSError, subprocess.CalledProcessError) as exc:
            print(exc, file=sys.stderr)
            return 1
        return 0
    if args.command == "routines":
        for routine in load_routines().values():
            confirmation = "confirmation" if routine["requires_confirmation"] else "direct"
            print(f"{routine['id']:<16} {routine['label']} [{confirmation}; {routine['duration']}]")
        return 0
    if args.command in {"run", "ask"}:
        routine_id = args.routine if args.command == "run" else "ask"
        input_value = args.input if args.command == "run" else args.question
        confirmed = args.yes if args.command == "run" else False
        try:
            receipt = run_routine(
                routine_id,
                input_value=input_value,
                confirmed=confirmed,
                action_id=args.action_id if args.command == "run" else None,
                opportunity_id=args.opportunity_id if args.command == "run" else None,
            )
        except (ValueError, PermissionError) as exc:
            print(exc, file=sys.stderr)
            return 2
        print(json.dumps(receipt, indent=2))
        return 0 if receipt["result"] == "completed" and receipt["refreshed_world_state"] else 1
    if args.command == "analyst":
        try:
            receipt = run_analyst(args.arguments, args.model, args.yes)
        except (ValueError, PermissionError) as exc:
            print(exc, file=sys.stderr)
            return 2
        print(json.dumps(receipt, indent=2))
        return 0 if receipt["result"] == "completed" and receipt["refreshed_world_state"] else 1
    if args.command == "new-directive":
        path = create_directive(
            DIRECTIVES_DIR,
            args.target,
            args.instruction,
            args.action_type,
            args.rationale,
            args.source_refs,
            args.constraints,
        )
        print(path)
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
