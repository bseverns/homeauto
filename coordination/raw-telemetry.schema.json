{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-telemetry.schema.json",
  "title": "Homeauto raw telemetry envelope",
  "type": "object",
  "required": ["contract", "collected_at", "sources"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "schema_version"],
      "properties": {
        "name": {"const": "homeauto-raw-telemetry"},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "collected_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "observed_at", "freshness_seconds", "sensitivity", "confidence", "payload"],
        "properties": {
          "source": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {"kind": {"type": "string"}, "name": {"type": "string"}}
          },
          "observed_at": {"type": ["string", "null"]},
          "freshness_seconds": {"type": "integer", "minimum": 1},
          "sensitivity": {"enum": ["public", "internal", "household", "private"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "payload": {}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
