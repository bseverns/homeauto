{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-state.schema.json",
  "title": "Homeauto interpreted world state",
  "type": "object",
  "required": ["contract", "generated_at", "opportunity_contract", "inputs", "observations", "machines", "capabilities", "opportunities", "situations", "transitions", "boundaries"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "schema_version", "authority"],
      "properties": {
        "name": {"const": "homeauto-world-state"},
        "schema_version": {"const": "1.1.0"},
        "authority": {"const": "read-only; no control actions"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "opportunity_contract": {
      "type": "object",
      "required": ["name", "schema_version", "authority", "prose_inference_allowed"],
      "properties": {
        "name": {"const": "lab-opportunities"},
        "schema_version": {"const": "1.0.0"},
        "authority": {"const": "derived_operator_state"},
        "prose_inference_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": ["benlab", "schedule", "world_state"],
      "properties": {
        "benlab": {"type": "object"},
        "schedule": {"type": "object"},
        "world_state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "observed_at", "freshness", "sensitivity", "confidence", "value"],
        "properties": {
          "id": {"type": "string"},
          "source": {
            "type": "object",
            "required": ["kind", "name", "domain", "semantic", "state_kind"],
            "properties": {
              "kind": {"type": "string"},
              "name": {"type": "string"},
              "key": {"type": "string"},
              "domain": {"type": "string"},
              "semantic": {"type": "string"},
              "state_kind": {"enum": ["state", "retained", "event"]},
              "affordances": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "affordance_scope": {"type": "string"}
            }
          },
          "observed_at": {"type": ["string", "null"]},
          "freshness": {
            "type": "object",
            "required": ["status", "age_seconds", "limit_seconds"],
            "properties": {
              "status": {"enum": ["fresh", "stale", "unknown"]},
              "age_seconds": {"type": ["integer", "null"], "minimum": 0},
              "limit_seconds": {"type": "integer", "minimum": 1}
            }
          },
          "sensitivity": {"enum": ["public", "internal", "household", "private"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "docs_ref", "scope", "dashboard", "lifecycle", "capabilities", "readiness", "runtime", "freshness", "affordances", "affordance_scope", "evidence", "why"],
        "properties": {
          "id": {"type": "string", "pattern": "^studio-machine:[a-z0-9-]+$"},
          "label": {"type": "string"},
          "docs_ref": {"type": ["string", "null"]},
          "scope": {"type": "string"},
          "dashboard": {"type": "boolean"},
          "lifecycle": {"enum": ["operational", "project", "research", "commissioning", "offline", "retired", "unknown"]},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "readiness": {"enum": ["ready", "busy", "needs_attention", "project", "research", "unknown", "unavailable"]},
          "runtime": {"type": "string"},
          "freshness": {"enum": ["fresh", "stale", "unknown", "unavailable"]},
          "affordances": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "affordance_scope": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "why": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "scope", "state", "available_resources", "evidence"],
        "properties": {
          "capability": {"type": "string"},
          "scope": {"type": "string"},
          "state": {"enum": ["ready", "busy", "needs_attention", "unknown"]},
          "available_resources": {"type": "integer", "minimum": 0},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opportunity_id", "action_id", "project_id", "state", "action", "capacity", "affordances", "why", "provenance", "warnings"],
        "properties": {
          "opportunity_id": {"type": "string"},
          "action_id": {"type": "string"},
          "project_id": {"type": ["string", "null"]},
          "state": {"enum": ["available", "capacity_stale", "runtime_stale", "missing_affordance", "blocked", "insufficient_information", "not_currently_eligible"]},
          "action": {"type": "object"},
          "capacity": {"type": ["object", "null"]},
          "affordances": {
            "type": "object",
            "required": ["required", "available", "missing", "providers"],
            "properties": {
              "required": {"type": "array", "items": {"type": "string"}},
              "available": {"type": "array", "items": {"type": "string"}},
              "missing": {"type": "array", "items": {"type": "string"}},
              "providers": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "why": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["check", "result", "detail", "source_ids"],
              "properties": {
                "check": {"type": "string"},
                "result": {"enum": ["pass", "fail", "unknown"]},
                "detail": {"type": "string"},
                "source_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "provenance": {"type": "array", "items": {"type": "object"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "situations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "state", "confidence", "rule", "evidence", "why"],
        "properties": {
          "evidence": {"type": "array", "items": {"type": "string"}},
          "why": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["situation_id", "action_id", "from", "to", "changed_at", "cause", "source_ids"],
        "properties": {
          "situation_id": {"type": "string"},
          "action_id": {"type": ["string", "null"]},
          "from": {"type": ["string", "null"]},
          "to": {"type": ["string", "null"]},
          "changed_at": {"type": "string"},
          "cause": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "boundaries": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
