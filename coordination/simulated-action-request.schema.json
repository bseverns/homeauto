{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulated-action-request.schema.json",
  "title": "Phase C0 simulated action request",
  "type": "object",
  "required": [
    "request_id",
    "action_id",
    "target_id",
    "desired_state",
    "expected_prior_state",
    "requested_at",
    "expires_at",
    "idempotency_key"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "action_id": {"const": "indicator.set"},
    "target_id": {"const": "fixture:indicator-01"},
    "desired_state": {"enum": ["on", "off"]},
    "expected_prior_state": {"enum": ["on", "off"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"}
  },
  "additionalProperties": false
}
